<div class="modal fade" id="preferences-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Preferences</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="preferences-modal-body">
        <div class="preferences-row">
          <label class="preferences-label" for="pref-break-input">Break reminder</label>
          <div class="preferences-input-wrap">
            <input type="number" min="0" step="1" class="form-control form-control-sm" id="pref-break-input">
            <span class="preferences-unit">min</span>
          </div>
          <div class="preferences-hint">Warn me this many minutes before my 15-minute break ends.</div>
        </div>
        <div class="preferences-row">
          <label class="preferences-label" for="pref-lunch-input">Lunch reminder</label>
          <div class="preferences-input-wrap">
            <input type="number" min="0" step="1" class="form-control form-control-sm" id="pref-lunch-input">
            <span class="preferences-unit">min</span>
          </div>
          <div class="preferences-hint">Warn me this many minutes before my 60-minute lunch ends.</div>
        </div>
        <!-- Supervisors only; revealed by preferences-panel.js once the user loads. -->
        <div id="preferences-queue-alerts" style="display:none">
          <hr class="preferences-divider">
          <div class="preferences-row">
            <label class="preferences-check">
              <input type="checkbox" id="pref-queue-alerts-enabled">
              <span>Queue alerts (desktop notifications)</span>
            </label>
            <button type="button" class="btn btn-outline-secondary btn-sm preferences-test-btn" id="pref-queue-alerts-test">Test alert</button>
            <div class="preferences-hint" id="pref-queue-alerts-status"></div>
          </div>
          <div class="preferences-row">
            <label class="preferences-label" for="pref-queue-depth">Queue depth alert</label>
            <div class="preferences-input-wrap">
              <input type="number" min="1" max="100" step="1" class="form-control form-control-sm" id="pref-queue-depth">
              <span class="preferences-unit">calls</span>
            </div>
            <div class="preferences-hint">Notify me when this many callers are waiting (1 alerts on a single caller).</div>
          </div>
          <div class="preferences-row">
            <label class="preferences-label" for="pref-queue-wait">Long wait alert</label>
            <div class="preferences-input-wrap">
              <input type="number" min="1" max="60" step="1" class="form-control form-control-sm" id="pref-queue-wait">
              <span class="preferences-unit">min</span>
            </div>
            <div class="preferences-hint">Notify me once a caller has waited this long.</div>
          </div>
          <div class="preferences-row">
            <label class="preferences-check">
              <input type="checkbox" id="pref-queue-sound">
              <span>Play a sound with the alert</span>
            </label>
          </div>
          <div class="preferences-row">
            <label class="preferences-check">
              <input type="checkbox" id="pref-queue-sticky">
              <span>Keep alerts on screen until dismissed</span>
            </label>
            <div class="preferences-hint">Otherwise they fade after a few seconds. Chrome and Edge honor this; Firefox and Safari dismiss on their own regardless.</div>
          </div>
        </div>
      </div>
      <div class="modal-footer d-flex justify-content-between align-items-center">
        <span id="preferences-feedback" class="settings-feedback"></span>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" id="preferences-reset-btn" disabled>Discard</button>
          <button type="button" class="btn btn-primary btn-sm" id="preferences-save-btn" disabled>Save</button>
        </div>
      </div>
    </div>
  </div>
</div>
