<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports</title>
  <link rel="icon" type="image/png" href="/dashboard/black_ops_a.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.css">
  <link rel="stylesheet" href="/dashboard/dashboard.css">
  <link rel="stylesheet" href="/dashboard/reports.css">
</head>
<body>

  <%- include('partials/topbar', { pageName: 'Reports' }) %>
  <%- include('partials/issues-ticker') %>
  <%- include('partials/tracked-issue-modals') %>
  <%- include('partials/preferences-modal') %>
  <%- include('partials/user-flags-modal') %>
  <%- include('partials/settings-modal') %>
  <%- include('partials/announcement-compose-modal') %>

  <div class="container py-3" style="max-width: 1400px;">

    <!-- Access denied message (hidden by default) -->
    <div id="access-denied" style="display:none">
      <div class="card">
        <div class="card-body text-center py-5">
          <h5>Access Denied</h5>
          <p class="text-muted">You don't have access to reports. Contact an administrator if you think this is wrong.</p>
          <a href="/dashboard/" class="btn btn-primary btn-sm">Back to Dashboard</a>
        </div>
      </div>
    </div>

    <!-- Reports content (hidden until verified) -->
    <div id="reports-content" style="display:none">

      <!-- Date Range Controls -->
      <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2 flex-wrap">
          <strong>Date Range</strong>
          <div class="d-flex align-items-center gap-2 ms-auto flex-wrap">
            <select class="form-select form-select-sm" id="team-member-select" style="width:auto">
              <option value="">All Team</option>
            </select>
            <select class="form-select form-select-sm" id="date-range-select" style="width:auto">
              <option value="thisWeek">This Week</option>
              <option value="lastWeek">Last Week</option>
              <option value="thisMonth" selected>This Month</option>
              <option value="lastMonth">Last Month</option>
              <option value="custom">Custom Range</option>
            </select>
            <div id="custom-date-range" class="d-flex align-items-center gap-2" style="display:none !important">
              <input type="date" id="start-date" class="form-control form-control-sm" style="width:auto" title="Start date">
              <span>to</span>
              <input type="date" id="end-date" class="form-control form-control-sm" style="width:auto" title="End date">
            </div>
            <button class="btn btn-outline-secondary btn-sm" id="export-csv-btn" disabled title="Export CSV">CSV</button>
            <button class="btn btn-outline-secondary btn-sm" id="export-pdf-btn" disabled title="Export PDF">PDF</button>
          </div>
        </div>
      </div>

      <!-- Loading indicator -->
      <div id="reports-loading" style="display:none">
        <div class="text-center py-5 text-muted">Loading reports...</div>
      </div>

      <!-- Error message (hidden unless an error occurs) -->
      <div id="reports-error" style="display:none">
        <div class="card"><div class="card-body text-center text-danger py-4"></div></div>
      </div>

      <!-- Report sections (hidden until data loads) -->
      <div id="reports-data" style="display:none">

        <!-- Call Volumes -->
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2">
            <strong>Call Volumes</strong>
            <select class="form-select form-select-sm ms-auto chart-type-select" id="volume-chart-type" style="width:auto">
              <option value="bar">Bar</option>
              <option value="line">Line</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary chart-toggle" data-target="volume-chart-wrap">Hide Chart</button>
          </div>
          <div class="card-body">
            <div class="row g-2 mb-3" id="volume-totals"></div>
            <div class="chart-container mb-3" id="volume-chart-wrap"><canvas id="volume-chart"></canvas></div>
            <div class="table-responsive" id="volume-daily-table"></div>
          </div>
        </div>

        <!-- Duration / Responsiveness -->
        <div class="card mb-3">
          <div class="card-header"><strong>Duration / Responsiveness</strong></div>
          <div class="card-body">
            <div class="row g-2" id="duration-stats"></div>
          </div>
        </div>

        <!-- Flagged Records (only shown when there are anomalous calls) -->
        <div class="card mb-3" id="flagged-calls-card" style="display:none">
          <div class="card-header d-flex align-items-center gap-2">
            <strong>Flagged Records</strong>
            <span class="text-muted small">durations over 8 hours — excluded from stats above</span>
            <span class="count ms-auto" id="flagged-calls-count">0</span>
          </div>
          <div class="card-body">
            <div class="table-responsive" id="flagged-calls-table"></div>
          </div>
        </div>

        <!-- Agent Activity -->
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2">
            <strong>Agent Activity</strong>
            <select class="form-select form-select-sm ms-auto chart-type-select" id="agent-chart-type" style="width:auto">
              <option value="bar">Bar</option>
              <option value="stacked">Stacked Bar</option>
              <option value="line">Line</option>
              <option value="doughnut">Doughnut</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary chart-toggle" data-target="agent-chart-wrap">Hide Chart</button>
          </div>
          <div class="card-body">
            <div id="agent-chart-wrap">
              <div class="row g-3 mb-3">
                <div class="col-md-4"><div class="chart-container"><canvas id="agent-calls-chart"></canvas></div></div>
                <div class="col-md-4"><div class="chart-container"><canvas id="agent-time-chart"></canvas></div></div>
                <div class="col-md-4"><div class="chart-container"><canvas id="agent-long-chart"></canvas></div></div>
              </div>
            </div>
            <div id="agent-activity-table" class="p-0"></div>
          </div>
        </div>

        <!-- Salesforce Cases -->
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2">
            <strong>Salesforce Cases</strong>
            <span class="count" id="cases-count">0</span>
          </div>
          <div class="card-body">
            <div class="row g-2 mb-3" id="cases-stats"></div>
            <input type="search" id="case-search" class="form-control form-control-sm mb-2" style="max-width:300px" placeholder="Search cases..." autocomplete="off">
            <div class="table-responsive" id="cases-table"></div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
  <script src="/dashboard/tracked-issue-emoji-picker.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.4/dist/jspdf.plugin.autotable.min.js"></script>
  <script src="/dashboard/topbar.js"></script>
  <script src="/dashboard/preferences-panel.js"></script>
  <script src="/dashboard/user-flags-panel.js"></script>
  <script src="/dashboard/dashboard-settings-panel.js"></script>
  <script src="/dashboard/announcements-shared.js"></script>
  <script src="/dashboard/announcement-compose.js"></script>
  <script src="/dashboard/issues-ticker.js"></script>
  <script src="/dashboard/tracked-issues-compose.js"></script>
  <script src="/dashboard/reports.js"></script>
</body>
</html>
