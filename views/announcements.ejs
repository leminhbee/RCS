<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Announcements</title>
  <link rel="icon" type="image/png" href="/dashboard/black_ops_a.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/dashboard/dashboard.css">
</head>
<body>

  <%- include('partials/topbar', { pageName: 'Announcements' }) %>

  <div class="container py-3" style="max-width: 1100px;">

    <div class="card mb-3">
      <div class="card-header d-flex align-items-center gap-2 flex-wrap">
        <strong>Announcements</strong>
        <div class="btn-group btn-group-sm ms-3" role="group" id="announcement-filter">
          <button type="button" class="btn btn-outline-primary active" data-filter="active">Active</button>
          <button type="button" class="btn btn-outline-primary" data-filter="cleared">Cleared</button>
          <button type="button" class="btn btn-outline-primary" data-filter="all">All</button>
        </div>
        <button type="button" class="btn btn-primary btn-sm ms-auto" id="announcement-page-compose-btn" style="display:none" data-bs-toggle="modal" data-bs-target="#announcement-compose-modal">+ New Announcement</button>
      </div>
      <div class="card-body">
        <div id="announcement-list">Loading…</div>
      </div>
    </div>
  </div>

  <!-- Compose Announcement Modal (supervisors) -->
  <div class="modal fade" id="announcement-compose-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">New Announcement</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label" for="announcement-compose-title">Title</label>
            <input type="text" id="announcement-compose-title" class="form-control form-control-sm" maxlength="200">
          </div>
          <div class="mb-2">
            <label class="form-label" for="announcement-compose-body">Body</label>
            <textarea id="announcement-compose-body" class="form-control form-control-sm" rows="5"></textarea>
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-between align-items-center">
          <span id="announcement-compose-feedback" class="settings-feedback"></span>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary btn-sm" id="announcement-compose-post-btn">Post</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/dashboard/topbar.js"></script>
  <script src="/dashboard/announcements-shared.js"></script>
  <script src="/dashboard/announcements.js"></script>
</body>
</html>
