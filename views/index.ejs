<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Queue Dashboard</title>
  <link rel="icon" type="image/png" href="/dashboard/black_ops_a.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.css">
  <link rel="stylesheet" href="/dashboard/dashboard.css">
</head>
<body>

  <%- include('partials/topbar') %>
  <%- include('partials/announcement-banner') %>
  <%- include('partials/issues-ticker') %>
  <%- include('partials/tracked-issue-modals') %>
  <%- include('partials/preferences-modal') %>
  <%- include('partials/user-flags-modal') %>
  <%- include('partials/settings-modal') %>
  <%- include('partials/announcement-compose-modal') %>

  <div class="container py-3" style="max-width: 1400px;">

    <div class="card mb-3">
      <div class="card-header d-flex align-items-center gap-2">
        <strong>Agents</strong> <span class="count" id="agent-count">0</span>
      </div>
      <div class="card-body p-0" id="agents-table"></div>
    </div>

    <div class="card mb-3">
      <div class="card-header d-flex align-items-center gap-2">
        <strong>Queue</strong> <span class="count" id="queue-count">0</span>
      </div>
      <div class="card-body p-0" id="queue-table"></div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body live-card">
            <div><div class="live-label">Longest Waiting</div><div class="live-detail" id="live-wait-detail">--</div></div>
            <div class="live-value" id="live-wait-value">--</div>
          </div>
        </div>
      </div>
      <div class="col-md-6" id="live-active-card" style="display:none">
        <div class="card h-100">
          <div class="card-body live-card">
            <div><div class="live-label">Longest Active Call</div><div class="live-detail" id="live-active-detail">--</div></div>
            <div class="live-value" id="live-active-value">--</div>
          </div>
        </div>
      </div>
    </div>

    <div id="stats-container"></div>
  </div>

  <!-- Repeat Caller Modal -->
  <div class="modal fade" id="repeat-caller-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="repeat-caller-modal-title">Calls from --</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-0" id="repeat-caller-modal-body"></div>
      </div>
    </div>
  </div>

  <!-- Confirm Remove Modal -->
  <div class="modal fade" id="confirm-remove-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Remove from queue?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">This will remove the caller from the queue.</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger btn-sm" id="confirm-remove-btn">Remove</button>
        </div>
      </div>
    </div>
  </div>




  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
  <script src="/dashboard/tracked-issue-emoji-picker.js"></script>
  <script src="/dashboard/topbar.js"></script>
  <script src="/dashboard/announcement-banner.js"></script>
  <script src="/dashboard/preferences-panel.js"></script>
  <script src="/dashboard/user-flags-panel.js"></script>
  <script src="/dashboard/dashboard-settings-panel.js"></script>
  <script src="/dashboard/issues-ticker.js"></script>
  <script src="/dashboard/tracked-issues-compose.js"></script>
  <script src="/dashboard/announcements-shared.js"></script>
  <script src="/dashboard/announcement-compose.js"></script>
  <script src="/dashboard/dashboard.js"></script>
</body>
</html>
