<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Queue Dashboard</title>
  <link rel="icon" type="image/png" href="/dashboard/black_ops_a.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/dashboard/dashboard.css">
</head>
<body>

  <div id="announcement-banner" class="announcement-banner" style="display:none"></div>

  <%- include('partials/topbar') %>

  <div class="container py-3" style="max-width: 1400px;">

    <div class="card mb-3">
      <div class="card-header d-flex align-items-center gap-2">
        <strong>Agents</strong> <span class="count" id="agent-count">0</span>
      </div>
      <div class="card-body p-0" id="agents-table"></div>
    </div>

    <div class="card mb-3">
      <div class="card-header d-flex align-items-center gap-2">
        <strong>Queue</strong> <span class="count" id="queue-count">0</span>
      </div>
      <div class="card-body p-0" id="queue-table"></div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body live-card">
            <div><div class="live-label">Longest Waiting</div><div class="live-detail" id="live-wait-detail">--</div></div>
            <div class="live-value" id="live-wait-value">--</div>
          </div>
        </div>
      </div>
      <div class="col-md-6" id="live-active-card" style="display:none">
        <div class="card h-100">
          <div class="card-body live-card">
            <div><div class="live-label">Longest Active Call</div><div class="live-detail" id="live-active-detail">--</div></div>
            <div class="live-value" id="live-active-value">--</div>
          </div>
        </div>
      </div>
    </div>

    <div id="stats-container"></div>
  </div>

  <!-- Repeat Caller Modal -->
  <div class="modal fade" id="repeat-caller-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="repeat-caller-modal-title">Calls from --</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-0" id="repeat-caller-modal-body"></div>
      </div>
    </div>
  </div>

  <!-- Confirm Remove Modal -->
  <div class="modal fade" id="confirm-remove-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Remove from queue?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">This will remove the caller from the queue.</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger btn-sm" id="confirm-remove-btn">Remove</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Preferences Modal (any user — edits their own reminders) -->
  <div class="modal fade" id="preferences-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Preferences</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="preferences-modal-body">
          <div class="preferences-row">
            <label class="preferences-label" for="pref-break-input">Break reminder</label>
            <div class="preferences-input-wrap">
              <input type="number" min="0" step="1" class="form-control form-control-sm" id="pref-break-input">
              <span class="preferences-unit">min</span>
            </div>
            <div class="preferences-hint">Warn me this many minutes before my 15-minute break ends.</div>
          </div>
          <div class="preferences-row">
            <label class="preferences-label" for="pref-lunch-input">Lunch reminder</label>
            <div class="preferences-input-wrap">
              <input type="number" min="0" step="1" class="form-control form-control-sm" id="pref-lunch-input">
              <span class="preferences-unit">min</span>
            </div>
            <div class="preferences-hint">Warn me this many minutes before my 60-minute lunch ends.</div>
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-between align-items-center">
          <span id="preferences-feedback" class="settings-feedback"></span>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="preferences-reset-btn" disabled>Discard</button>
            <button type="button" class="btn btn-primary btn-sm" id="preferences-save-btn" disabled>Save</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- User Permissions Modal (Supervisors + SuperAdmins) -->
  <div class="modal fade" id="user-flags-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">User Permissions</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-0">
          <ul class="nav nav-tabs user-flags-tabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="user-flags-tab-permissions" data-bs-toggle="tab" data-bs-target="#user-flags-pane-permissions" type="button" role="tab">Permissions</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="user-flags-tab-reminders" data-bs-toggle="tab" data-bs-target="#user-flags-pane-reminders" type="button" role="tab">Reminders</button>
            </li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane fade show active" id="user-flags-pane-permissions" role="tabpanel">
              <div id="user-flags-modal-body">Loading...</div>
            </div>
            <div class="tab-pane fade" id="user-flags-pane-reminders" role="tabpanel">
              <div id="user-flags-reminders-body">Loading...</div>
            </div>
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-between align-items-center">
          <span id="user-flags-feedback" class="settings-feedback"></span>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="user-flags-reset-btn" disabled>Discard</button>
            <button type="button" class="btn btn-primary btn-sm" id="user-flags-save-btn" disabled>Save</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Settings Modal (SuperAdmin only) -->
  <div class="modal fade" id="settings-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Dashboard Settings</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="settings-modal-body">Loading...</div>
        <div class="modal-footer d-flex justify-content-between align-items-center">
          <span id="settings-feedback" class="settings-feedback"></span>
          <button type="button" class="btn btn-primary btn-sm" id="settings-save-btn">Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Acknowledge Announcements Modal (non-supervisors with unacked items) -->
  <div class="modal fade" id="announcement-ack-modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Announcements — please acknowledge</h5>
        </div>
        <div class="modal-body" id="announcement-ack-modal-body"></div>
      </div>
    </div>
  </div>

  <!-- Compose Announcement Modal (supervisors) -->
  <div class="modal fade" id="announcement-compose-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">New Announcement</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label" for="announcement-compose-title">Title</label>
            <input type="text" id="announcement-compose-title" class="form-control form-control-sm" maxlength="200">
          </div>
          <div class="mb-2">
            <label class="form-label" for="announcement-compose-body">Body</label>
            <textarea id="announcement-compose-body" class="form-control form-control-sm" rows="5"></textarea>
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-between align-items-center">
          <span id="announcement-compose-feedback" class="settings-feedback"></span>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary btn-sm" id="announcement-compose-post-btn">Post</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Acknowledgement Status Modal (supervisors) -->
  <div class="modal fade" id="announcement-acks-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="announcement-acks-modal-title">Acknowledgement Status</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="announcement-acks-modal-body">Loading…</div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/dashboard/topbar.js"></script>
  <script src="/dashboard/announcements-shared.js"></script>
  <script src="/dashboard/dashboard.js"></script>
</body>
</html>
